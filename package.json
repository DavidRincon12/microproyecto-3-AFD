{
  "name": "automatas-finitos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint && prettier --check . && npm run lint:arch",
    "lint:arch": "depcruise src",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@viz-js/viz": "3.31.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "18.7.2",
    "jsdom": "31.0.1",
    "oxlint": "^1.90.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  }
}
